   "source": [
    "# 49W — Scrape YouTube Transcripts\n",
    "Fetches all video transcripts from the 49W channel and saves them to Google Drive.\n",
    "\n",
    "**No YouTube API key needed.**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "install",
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q scrapetube youtube-transcript-api tqdm"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "mount-drive",
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import drive\n",
    "drive.mount('/content/drive')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "config",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── CONFIG ─────────────────────────────────────────────────\n",
    "# Paste the 49W channel URL or handle here\n",
    "CHANNEL_URL = \"https://www.youtube.com/@kirkdokuzW\"  # or UC... channel ID\n",
    "\n",
    "# Where to save on your Drive\n",
    "OUTPUT_DIR = \"/content/drive/MyDrive/49w-bot/data/raw/transcripts\"\n",
    "\n",
    "# Transcript language preference (tries Turkish first, falls back to English)\n",
    "LANGUAGES = [\"tr\", \"en\"]\n",
    "# ────────────────────────────────────────────────────────────"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "scrape",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "import time\n",
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "import scrapetube\n",
    "from youtube_transcript_api import YouTubeTranscriptApi, NoTranscriptFound, TranscriptsDisabled\n",
    "from tqdm.notebook import tqdm\n",
    "\n",
    "Path(OUTPUT_DIR).mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "def get_videos(channel_url: str):\n",
    "    \"\"\"Get all videos from a channel using scrapetube (no API key needed).\"\"\"\n",
    "    # scrapetube accepts channel URL, handle, or channel_id\n",
    "    if channel_url.startswith(\"UC\"):\n",
    "        videos = scrapetube.get_channel(channel_id=channel_url)\n",
    "    else:\n",
    "        videos = scrapetube.get_channel(channel_url=channel_url)\n",
    "    return list(videos)\n",
    "\n",
    "def fetch_transcript(video_id: str) -> list | None:\n",
    "    try:\n",
    "        return YouTubeTranscriptApi.get_transcript(video_id, languages=LANGUAGES)\n",
    "    except (NoTranscriptFound, TranscriptsDisabled):\n",
    "        return None\n",
    "    except Exception as e:\n",
    "        print(f\"  Error {video_id}: {e}\")\n",
    "        return None\n",
    "\n",
    "def transcript_to_text(transcript: list) -> str:\n",
    "    return \" \".join(seg[\"text\"].strip() for seg in transcript)\n",
    "\n",
    "# Fetch video list\n",
    "print(f\"Fetching video list from: {CHANNEL_URL}\")\n",
    "videos = get_videos(CHANNEL_URL)\n",
    "print(f\"Found {len(videos)} videos\")\n",
    "\n",
    "# Save video list\n",
    "video_list = [\n",
    "    {\n",
    "        \"video_id\": v[\"videoId\"],\n",
    "        \"title\": v[\"title\"][\"runs\"][0][\"text\"] if \"runs\" in v.get(\"title\", {}) else \"\",\n",
    "        \"published_time\": v.get(\"publishedTimeText\", {}).get(\"simpleText\", \"\"),\n",
    "    }\n",
    "    for v in videos\n",
    "]\n",
    "\n",
    "videos_path = Path(OUTPUT_DIR).parent / \"videos.json\"\n",
    "with open(videos_path, \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(video_list, f, ensure_ascii=False, indent=2)\n",
    "print(f\"Video list saved to {videos_path}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fetch-transcripts",
   "metadata": {},
   "outputs": [],
   "source": [
    "fetched, skipped, failed = 0, 0, 0\n",
    "\n",
    "for video in tqdm(video_list, desc=\"Fetching transcripts\"):\n",
    "    vid_id = video[\"video_id\"]\n",
    "    out_file = Path(OUTPUT_DIR) / f\"{vid_id}.json\"\n",
    "\n",
    "    if out_file.exists():\n",
    "        skipped += 1\n",
    "        continue\n",
    "\n",
    "    transcript = fetch_transcript(vid_id)\n",
    "\n",
    "    if transcript is None:\n",
    "        failed += 1\n",
    "        continue\n",
    "\n",
    "    record = {\n",
    "        \"video_id\": vid_id,\n",
    "        \"title\": video[\"title\"],\n",
    "        \"published_time\": video[\"published_time\"],\n",
    "        \"transcript_raw\": transcript,\n",
    "        \"transcript_text\": transcript_to_text(transcript),\n",
    "    }\n",
    "\n",
    "    with open(out_file, \"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(record, f, ensure_ascii=False, indent=2)\n",
    "\n",
    "    fetched += 1\n",
    "    time.sleep(0.5)  # be polite\n",
    "\n",
    "print(f\"\\nDone!\")\n",
    "print(f\"  Fetched  : {fetched}\")\n",
    "print(f\"  Cached   : {skipped}\")\n",
    "print(f\"  No transcript: {failed}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "summary",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Quick summary of what we collected\n",
    "files = list(Path(OUTPUT_DIR).glob(\"*.json\"))\n",
    "total_words = 0\n",
    "for f in files:\n",
    "    with open(f) as fp:\n",
    "        d = json.load(fp)\n",
    "    total_words += len(d[\"transcript_text\"].split())\n",
    "\n",
    "print(f\"Total transcripts saved : {len(files)}\")\n",
    "print(f\"Total words             : {total_words:,}\")\n",
    "print(f\"Avg words per video     : {total_words // max(len(files), 1):,}\")\n",
    "print(f\"\\nSaved to: {OUTPUT_DIR}\")"
   ]
  }
 ]
}"
